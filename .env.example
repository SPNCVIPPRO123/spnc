# Sao chép file này thành .env.local rồi điền API key của bạn.
# Lấy key tại: https://platform.claude.com (mục API Keys)
ANTHROPIC_API_KEY=

# (Tuỳ chọn) Đổi model AI. Mặc định: claude-opus-5-5
# Muốn tiết kiệm chi phí (rẻ hơn khoảng 2 lần) có thể dùng: claude-sonnet-5-5
# CLAUDE_MODEL=claude-opus-5-5

# ---- Lưu phiếu khảo sát cho chuyên viên xem (trang /chuyen-vien) ----
# Chuỗi kết nối Postgres. Trên Vercel: Storage → Create Database → Neon, Vercel tự thêm biến này.
# Chạy trên máy: vào Vercel → Settings → Environment Variables, sao chép giá trị DATABASE_URL vào đây.
DATABASE_URL=
# Mật khẩu chung cho chuyên viên, ít nhất 10 ký tự. Chỉ đưa cho chuyên viên tư vấn của trường.
STAFF_PASSWORD=
